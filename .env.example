# Database Configuration (mssql for Server Production, sqlite for Local Fallback)
DB_TYPE=mssql
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FRM_DB
DB_USER=sa
DB_PASSWORD=YOUR_SQL_PASSWORD_HERE
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Web Server Ports (HTTP for LAN browsers, HTTPS for PWA install)
PORT=5000
HTTPS_PORT=5443

# SQLite fallback path (used only if DB_TYPE=sqlite)
SQLITE_DB_PATH=backend/database/factoryflow.db

# Optional SMTP Credentials (for License Activation Request emails)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
