# Database Configuration (sqlite for GoDaddy / Cloud, mssql for local SQL Server)
DB_TYPE=sqlite
SQLITE_DB_PATH=backend/database/FRM-BBP.db

# Optional MS SQL Server configuration (if DB_TYPE=mssql)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FRM_DB
DB_USER=sa
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Server Port (Passenger / cPanel sets PORT automatically)
PORT=5000

# Optional SMTP Credentials (for email notifications)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
