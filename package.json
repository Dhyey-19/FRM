{
  "name": "factory-flow-desktop",
  "version": "0902.0.0",
  "description": "FactoryFlow Desktop Application",
  "author": "FactoryFlow",
  "main": "electron/main.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "update-version": "node scripts/update-version.js",
    "dev": "concurrently -k \"npm run dev -w frontend\" \"npm run dev -w backend\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "predist": "npm run update-version",
    "dist": "npm run build && electron-builder",
    "prebuild:exe": "npm run update-version",
    "build:exe": "npm run update-version && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npm run dist"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mssql": "^12.5.5",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.factoryflow.desktop",
    "productName": "FactoryFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "DTech",
      "icon": "build/icon.png",
      "artifactName": "${productName}-20261013.${ext}",
      "certificateFile": "certs/DTech.pfx",
      "certificatePassword": "factoryflow"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FactoryFlow"
    }
  }
}