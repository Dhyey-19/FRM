{
  "name": "factory-flow-desktop",
  "version": "20260614.0.0",
  "description": "FactoryFlow Desktop Application",
  "author": "FactoryFlow Publisher",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev --prefix frontend\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mssql": "^12.5.5",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.factoryflow.desktop",
    "productName": "FactoryFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "FactoryFlow Publisher",
      "icon": "build/icon.png",
      "artifactName": "${productName}-20260614.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FactoryFlow"
    }
  }
}
