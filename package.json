{
  "name": "frm",
  "version": "20261104.0.0",
  "description": "FRM - Factory Resource Manager",
  "author": "FRM",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run dev",
    "server": "node backend/server.js",
    "publish": "node scripts/publish.js",
    "tunnel": "npx localtunnel --port 5000",
    "cert": "node scripts/generate-cert.js",
    "update-version": "node scripts/update-version.js",
    "dev": "concurrently -k \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "db:init": "node backend/database/init-db.js",
    "postinstall": "node backend/database/init-db.js",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mssql": "^12.5.5",
    "nodemailer": "^8.0.11",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
